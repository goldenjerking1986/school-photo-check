.container {
  padding: 20rpx;
}

.camera {
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 20rpx 0;
  color: #333;
  font-size: 28rpx;
}

.btn {
  background: linear-gradient(90deg, #2F80ED, #56CCF2);
  color: white;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}
