# Backend environment example (same as root .env.example, kept here for convenience)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=school_photo_check

JWT_SECRET=replace-with-very-strong-random-string

# WeChat
WX_APPID=wxxxxxxxxxxxxxxxxx
WX_SECRET=your_wechat_app_secret

# COS
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key

PORT=3000
