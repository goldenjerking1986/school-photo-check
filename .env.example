# Environment variables example for school-photo-check

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=school_photo_check

# JWT secret (REPLACE with a strong secret in production)
JWT_SECRET=replace-with-very-strong-random-string

# WeChat Mini Program credentials (required for real login)
# - WX_APPID: the AppID of your WeChat Mini Program
# - WX_SECRET: the App Secret for the Mini Program
# These must be set for /auth/login to exchange code for openid
WX_APPID=wxxxxxxxxxxxxxxxxx
WX_SECRET=your_wechat_app_secret

# Object storage (Tencent COS example). Replace with your provider details.
COS_BUCKET=your-bucket-1250000000
COS_REGION=ap-guangzhou
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key

# Server port (optional)
PORT=3000
